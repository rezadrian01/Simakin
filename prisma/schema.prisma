// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/**
 * ================================
 * ENUMS
 * =================================
 */

enum Role {
  USER
  ADMIN
}

enum RecitationMode {
  MUROJAAH
  ZIYADAH
}

enum RecitationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MemorizationStatus {
  PLANNED      // User plans to memorize this
  IN_PROGRESS  // Currently working on it
  COMPLETED    // Finished memorizing
}

enum MemorizationSource {
  SIMAKIN      // Memorized through the app (via recitation)
  ONBOARDING   // Existing memorization from onboarding
  MANUAL       // Added manually by user
}

enum ReferralSource {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
  TWITTER
  WEBSITE
  GOOGLE_SEARCH
  FRIEND
  FAMILY
  TEACHER
  MOSQUE
  SCHOOL
  OTHER
}

// ============================================
// GAMIFICATION ENUMS
// ============================================

enum XPSource {
  RECITATION
  MINIGAME
  DAILY_CHALLENGE
}

enum GameType {
  SAMBUNG_AYAT
  TEBAK_SURAH
  LENGKAPI_AYAT
  URUTAN_AYAT
}

enum ChallengeType {
  COMPLETE_SESSIONS
  REACH_ACCURACY
  WIN_GAMES
}

/**
 * ================================
 * USER MODELS
 * =================================
 */

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  username     String  @unique
  fullName     String?
  passwordHash String?
  avatarUrl    String?
  role         Role    @default(USER)

  profile          UserProfile?
  recitations      Recitation[]       @relation("user_recitations")
  userAchievements UserAchievement[]
  memorization     UserMemorization[]
  leaderboards     Leaderboard[]
  xpHistory        XPHistory[]
  gameSessions     GameSession[]
  dailyChallenges  UserDailyChallenge[]

  // aggregated stats for quick queries
  totalSessions    Int       @default(0)
  totalScore       Float     @default(0)
  streakDays       Int       @default(0)
  lastActivityDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model UserProfile {
  id            String          @id @default(cuid())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String          @unique
  preferredLang String          @default("id")
  theme         String          @default("light") // light | dark
  timezone      String          @default("Asia/Jakarta") // User's timezone for streak calculation
  bio           String?
  
  // Onboarding data
  referralSource ReferralSource? // How user found the app
  referralOther  String?         // Custom text if source is OTHER
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/**
 * ================================
 * CORE FEATURE: RECITATION
 * =================================
 */

model Recitation {
  id        String           @id @default(cuid())
  user      User             @relation("user_recitations", fields: [userId], references: [id])
  userId    String
  surah     Int
  startAyah Int
  endAyah   Int
  mode      RecitationMode
  status    RecitationStatus @default(PENDING)
  duration  Int?
  audioUrl  String?          // Google Cloud Storage URL for recorded audio
  expEarned Int              @default(0)  // EXP earned at session time (captures correct streak)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  feedback Feedback?
  
  // Link to memorization record (for ziyadah sessions)
  memorizationId String?
  memorization   UserMemorization? @relation(fields: [memorizationId], references: [id])
  
  @@index([userId])
  @@index([userId, mode])
  @@index([createdAt])
}

model Feedback {
  id               String     @id @default(cuid())
  recitationId     String     @unique
  recitation       Recitation @relation(fields: [recitationId], references: [id])
  transcription    String?    @db.Text
  memorizationErrs Json?
  tajweedErrs      Json?
  waqfErrs         Json?
  generalAdvice    String?    @db.Text
  accuracyScore    Float
  tajweedScore     Float
  fluencyScore     Float
  metadataQuran    Json? // metadata_quran
  createdAt        DateTime   @default(now())
}

model UserMemorization {
  id        String              @id @default(cuid())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  
  // Surah and ayah range
  surah     Int                 // Surah number (1-114)
  startAyah Int                 // Starting ayah number
  endAyah   Int                 // Ending ayah number
  
  // Status tracking
  status    MemorizationStatus  @default(COMPLETED)
  source    MemorizationSource  @default(SIMAKIN)
  
  // Metadata
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  // Relation to recitations (ziyadah sessions that created this memorization)
  recitations Recitation[]
  
  @@unique([userId, surah, startAyah, endAyah]) // Prevent duplicate ranges
  @@index([userId, status])
  @@index([userId, surah])
  @@index([userId, source])
}

/**
 * ================================
 * LEADERBOARD (PERFORMANCE SNAPSHOT)
 * =================================
 */

model Leaderboard {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period    String // e.g. "2025-10-06", "2025-W40", or "global"
  score     Float
  rank      Int?
  category  String? // e.g., "weekly", "overall", "juz-1"
  createdAt DateTime @default(now())

  @@unique([userId, period, category])
  @@index([period, score])
  @@index([userId, period])
}

/**
 * ================================
 * ACHIEVEMENTS (GAMIFICATION)
 * =================================
 */

model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique // e.g., "streak_7", "first_100_ayats"
  title       String
  description String?
  iconUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String @id @default(cuid())
  userId        String
  achievementId String

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  awardedAt DateTime @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

// ============================================
// XP HISTORY (GAMIFICATION)
// ============================================

model XPHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  source    XPSource
  sourceId  String?  // recitationId, gameSessionId, or userDailyChallengeId
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, source])
}

// ============================================
// GAME SESSION (GAMIFICATION)
// ============================================

model GameSession {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameType       GameType
  totalQuestions Int      // Always 10
  correctAnswers Int
  expEarned      Int
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([userId, gameType])
  @@index([userId, createdAt])
}

// ============================================
// DAILY CHALLENGES (GAMIFICATION)
// ============================================

model DailyChallenge {
  id          String        @id @default(cuid())
  type        ChallengeType
  targetValue Int           // e.g. 3 for sessions, 90 for accuracy, 2 for games
  expReward   Int
  description String

  userProgress UserDailyChallenge[]

  @@unique([type])
}

model UserDailyChallenge {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId     String
  challenge       DailyChallenge @relation(fields: [challengeId], references: [id])
  date            String         // "YYYY-MM-DD" in user's local timezone
  currentProgress Int            @default(0)
  isCompleted     Boolean        @default(false)
  completedAt     DateTime?
  expAwarded      Boolean        @default(false)

  @@unique([userId, challengeId, date])
  @@index([userId, date])
}
